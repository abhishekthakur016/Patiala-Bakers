# Base URL of the API. In development the Vite proxy forwards /api to http://localhost:5000,
# so leave this as /api. In production set it to your deployed API, e.g. https://api.patialabakers.com.au/api
VITE_API_URL=/api
# Origin that serves uploaded images when they are stored locally (blank = same origin / proxy)
VITE_ASSET_URL=
