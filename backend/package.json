{
  "name": "patiala-bakers-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Patiala Bakers REST API (Express + MongoDB)",
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon src/server.js",
